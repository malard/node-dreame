# Credentials for running examples/ + integration tests against a live device.
# Copy to .env (gitignored) and fill in your own values.

# The email you sign into the Dreamehome app with.
DREAME_EMAIL=you@example.com

# The Dreamehome account password. If your account uses social-login
# (Google/Apple), set a password under Account & Security in the app first
# so you have one you can pass programmatically.
DREAME_PASSWORD=

# Cloud region — one of: eu, us, cn, ru, sg, in, de, tw.
# Match the region your account is registered in (visible in the app's
# account settings; UK accounts use eu).
DREAME_REGION=eu
